[
  {
    "fields": [
      {
        "description": "Used to sort events on the website (ascending).",
        "name": "id",
        "type": "number",
        "title": "Order / ID"
      },
      {
        "initialValue": false,
        "description": "Toggles the event between the Upcoming and Past sections.",
        "name": "isUpcoming",
        "type": "boolean",
        "title": "Upcoming event"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "name": "name",
        "type": "string"
      },
      {
        "rows": 6,
        "name": "desc",
        "type": "text",
        "title": "Description"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "uri",
                "constraint": {
                  "options": {
                    "scheme": [
                      "/^http$/",
                      "/^https$/"
                    ],
                    "allowRelative": false,
                    "relativeOnly": false,
                    "allowCredentials": false
                  }
                }
              }
            ],
            "level": "error"
          }
        ],
        "description": "Thumbnail shown on the event card.",
        "name": "image",
        "type": "url",
